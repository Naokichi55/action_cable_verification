<% if user_signed_in? %>
   <% if racket.favorite_by?(current_user) %>
	  <%= link_to racket_favorite_path(racket, racket.favorites), data: {  turbo_method: :delete } do %>
		  <%= image_tag "heart_fil.svg", class: 'size-6 md:size-7 ml-1 bg-col-red' %>
		<% end %>
		  <%= racket.favorites.count %>
	<% else %>
	  <%= link_to racket_favorites_path(racket), data: { turbo_method: :post } do %>
		  <%= image_tag "heart.svg", class: 'size-6 md:size-7 ml-1 ' %>
		<% end %>
		 <%= racket.favorites.count %>
	<% end %>
<% end %>