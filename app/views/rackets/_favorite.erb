<% if logged_in ? %>
   <% if racket.favorite_by?(current_user) %>
	  <%= link_to racket_favorites_path(racket), data:{ turbo_method: :delete } do %>
		  <div class="fas fa-heart text-lg" aria-hidden="true" style="color: red;"></div>
			<%= racket.favorites.count %>
		<% end %>
	<% else %>
	  <%= link_to racket_favorites_path(racket), data: { turbo_method: :racket } do %>
		 <div class= "fas fa-heart text-lg" aria-hidden="true"></div>
		 <%= racket.favorites.count %>
		<% end %>
	<% end %>
<%end %>

